# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# ── Admin systems (override config.py) ───────────────────────────────────────
ADMIN_URL=
ADMIN_LOGIN=
ADMIN_PASSWORD=
BILLING_URL=
BILLING_LOGIN=
BILLING_PASSWORD=
SLAPI_URL=
SLAPI_LOGIN=
SLAPI_PASSWORD=
DELAY_BETWEEN_ACCOUNTS=1.5
HEADLESS=true

# ── Web server ───────────────────────────────────────────────────────────────
# Base URL colleagues open; used in Slack replies. e.g. http://account-setup.internal:8000
PUBLIC_BASE_URL=
# Optional HTTP basic auth for the UI: "alice:secret,bob:secret2". Empty = no login.
BASIC_AUTH=
# Optional: header with the user's email set by an auth proxy in front (e.g. X-Auth-Request-Email).
AUTH_USER_HEADER=

# ── Slack (optional) ─────────────────────────────────────────────────────────
# Slack app: Event Subscriptions -> Request URL <PUBLIC_BASE_URL>/slack/events,
# bot events message.channels (+ message.groups for a private channel);
# scopes chat:write, channels:history (+ groups:history). Invite the bot to the channel.
# Note: Slack must be able to reach /slack/events — if the server is internal-only,
# expose just that path (reverse proxy) or use Socket Mode instead.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Only messages in this channel are treated as requests (e.g. C0123456789).
SLACK_CHANNEL_ID=
